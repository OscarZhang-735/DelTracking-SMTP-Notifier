# 复制为 .env 后替换所有 change-me 值；不要提交真实 .env。
SESSION_SECRET=change-me-use-at-least-32-random-bytes
SMTP_ENCRYPTION_KEY=change-me-use-a-fernet-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-use-a-long-unique-password
TRACKING_APP_ID=change-me-nextsls-app-id

APP_TIMEZONE=Asia/Shanghai
SCHEDULE_INTERVAL_MINUTES=30
SESSION_MAX_AGE_SECONDS=28800

# 通过 HTTPS 反向代理部署时保持 true；仅在本机纯 HTTP 测试时设为 false。
COOKIE_SECURE=true
